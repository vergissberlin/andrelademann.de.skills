---
import ToolPageTemplate from '../components/templates/ToolPageTemplate.astro';

const baseUrl = (import.meta as ImportMeta & { env: { BASE_URL: string } }).env.BASE_URL;
const apiBaseUrl = (import.meta as ImportMeta & { env: { PUBLIC_SKILL_CREATOR_API_URL?: string } }).env.PUBLIC_SKILL_CREATOR_API_URL ?? '';
---

<ToolPageTemplate
  title="Skill Creator | André Lademann Skills"
  description="Create skill files with a chat-like workflow and download them as ZIP."
  heading="Skill Creator"
  subtitle="Describe what your skill should do, refine via chat, then export a ready-to-use ZIP package."
  baseUrl={baseUrl}
  canonicalUrl={`${baseUrl}skill-creator/`}
  ogImage={`${baseUrl}og/default.png`}
>
  <section id="skill-creator-root" data-base-url={baseUrl} data-api-base-url={apiBaseUrl} class="grid grid-cols-1 gap-4 lg:grid-cols-[1.2fr,0.8fr]">
    <article class="rounded-xs border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
      <h2 class="mb-2 text-2xl font-semibold text-slate-900 dark:text-slate-200">Chat</h2>
      <p class="text-sm text-slate-500 dark:text-slate-400">
        Start with your intent, for example: domain, trigger conditions, required output files, and constraints.
      </p>

      <div id="chat-messages" class="mt-4 flex h-[360px] flex-col gap-3 overflow-y-auto overflow-x-hidden rounded-xs border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-800" aria-live="polite"></div>
      <div id="clarification-questions" class="mt-4 hidden rounded-xs border border-kieks-aqua/30 bg-kieks-aqua-50 p-3 dark:bg-kieks-navy/40">
        <p class="text-xs font-semibold uppercase tracking-wide text-kieks-navy dark:text-kieks-aqua">Clarification questions</p>
        <div id="clarification-list" class="mt-2 space-y-3"></div>
        <button id="send-clarifications" class="mt-3 inline-flex min-h-10 items-center justify-center rounded-xs border border-transparent bg-kieks-aqua px-3 py-2 text-sm font-semibold text-kieks-navy disabled:cursor-not-allowed disabled:opacity-50" disabled>Send selected answers</button>
      </div>

      <label class="mb-1 mt-4 block text-sm font-semibold text-slate-700 dark:text-slate-400" for="chat-input">Message</label>
      <textarea
        id="chat-input"
        class="min-h-[120px] w-full resize-y rounded-xs border border-slate-200 bg-white p-3 text-sm text-slate-800 outline-none transition focus:border-kieks-aqua focus:ring-4 focus:ring-kieks-aqua/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:focus:border-kieks-aqua dark:focus:ring-kieks-navy/40"
        placeholder="Build a skill for diagnosing flaky Playwright tests in CI. It should include triage steps and retry guidance."
      ></textarea>
      <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">Hint: Press <kbd class="rounded border border-slate-300 px-1 py-0.5 text-[11px] dark:border-slate-600">Shift</kbd> + <kbd class="rounded border border-slate-300 px-1 py-0.5 text-[11px] dark:border-slate-600">Enter</kbd> to send your message.</p>

      <div class="mt-4 flex flex-wrap gap-3">
        <button id="chat-send" class="inline-flex min-h-11 items-center justify-center rounded-xs border border-transparent bg-slate-900 px-4 py-2 text-sm font-semibold text-white dark:bg-kieks-fuchsia">Send</button>
        <button id="chat-voice" class="inline-flex min-h-11 items-center justify-center rounded-xs border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800">🎤 Voice input</button>
        <button id="chat-finalize" class="inline-flex min-h-11 items-center justify-center rounded-xs border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800" disabled>Create ZIP</button>
      </div>
      <p id="chat-status" class="mt-3 text-sm text-slate-500 dark:text-slate-400">No messages yet.</p>
    </article>

    <article class="rounded-xs border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
      <h2 class="mb-2 text-2xl font-semibold text-slate-900 dark:text-slate-200">Package Preview</h2>
      <p class="text-sm text-slate-500 dark:text-slate-400">
        The finalized response must include `SKILL.md` and `metadata.json`. ZIP is generated in the browser.
      </p>
      <pre id="package-preview" class="mt-4 min-h-[320px] overflow-auto rounded-xs border border-slate-200 bg-slate-50 p-3 text-xs text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">No package generated yet.

Click "Create ZIP" after the chat is finalized to preview generated files.</pre>
      <a id="download-link" class="mt-4 hidden min-h-11 items-center justify-center rounded-xs border border-transparent bg-kieks-aqua px-4 py-2 text-sm font-semibold text-kieks-navy" download>Download ZIP</a>
    </article>
  </section>
</ToolPageTemplate>

<script>
  import JSZip from 'jszip';

  interface ChatMessage {
    role: 'user' | 'assistant';
    content: string;
  }

  interface FinalizePayload {
    skillFolderName: string;
    files: Record<string, string>;
  }

  interface ChatQuestion {
    id: string;
    label: string;
    multiSelect: boolean;
    options: string[];
  }

  interface ChatResponsePayload {
    message?: string;
    questions?: ChatQuestion[];
  }

  const root = document.getElementById('skill-creator-root');
  const apiBaseUrl = root?.getAttribute('data-api-base-url') ?? '';
  const chatBox = document.getElementById('chat-messages');
  const input = document.getElementById('chat-input') as HTMLTextAreaElement | null;
  const sendButton = document.getElementById('chat-send') as HTMLButtonElement | null;
  const voiceButton = document.getElementById('chat-voice') as HTMLButtonElement | null;
  const finalizeButton = document.getElementById('chat-finalize') as HTMLButtonElement | null;
  const status = document.getElementById('chat-status');
  const packagePreview = document.getElementById('package-preview');
  const downloadLink = document.getElementById('download-link') as HTMLAnchorElement | null;
  const clarificationQuestions = document.getElementById('clarification-questions');
  const clarificationList = document.getElementById('clarification-list');
  const sendClarificationsButton = document.getElementById('send-clarifications') as HTMLButtonElement | null;

  const messages: ChatMessage[] = [];
  let pendingQuestions: ChatQuestion[] = [];
  const selectedClarifications = new Map<string, Set<string>>();
  const SpeechRecognitionCtor = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
  let speechRecognition: any = null;
  let isVoiceListening = false;

  const escapeHtml = (value: string) =>
    value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');

  function renderMessages() {
    if (!chatBox) return;
    if (messages.length === 0) {
      chatBox.innerHTML = '<p class="text-sm text-slate-500 dark:text-slate-400">Say hi and describe your skill goals.</p>';
      return;
    }
    chatBox.innerHTML = messages
      .map((message) => {
        const bubbleClass =
          message.role === 'user'
            ? 'ml-auto border-kieks-aqua/30 bg-kieks-aqua-50 text-kieks-navy dark:bg-kieks-navy/50 dark:text-kieks-aqua'
            : 'mr-auto border-slate-200 bg-white text-slate-800 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200';
        const roleLabel = message.role === 'user' ? 'You' : 'Assistant';
        return `<article class="max-w-[92%] rounded-xs border p-3 ${bubbleClass}">
          <p class="mb-1 text-xs font-semibold uppercase tracking-wide opacity-70">${roleLabel}</p>
          <p class="whitespace-pre-wrap text-sm">${escapeHtml(message.content)}</p>
        </article>`;
      })
      .join('');
    chatBox.scrollTop = chatBox.scrollHeight;
  }

  function hasAllQuestionAnswers() {
    return pendingQuestions.length > 0
      && pendingQuestions.every((question) => (selectedClarifications.get(question.id)?.size ?? 0) > 0);
  }

  function renderClarificationQuestions() {
    if (!clarificationQuestions || !clarificationList || !sendClarificationsButton) return;
    if (!pendingQuestions.length) {
      clarificationQuestions.classList.add('hidden');
      clarificationList.innerHTML = '';
      sendClarificationsButton.disabled = true;
      return;
    }

    clarificationQuestions.classList.remove('hidden');
    clarificationList.innerHTML = pendingQuestions
      .map((question, questionIndex) => {
        const selectedOptions = selectedClarifications.get(question.id) ?? new Set<string>();
        const optionsHtml = question.options
          .map((option) => {
            const isSelected = selectedOptions.has(option);
            if (question.multiSelect) {
              return `<label class="inline-flex items-center gap-2 rounded-xs border px-2 py-1 text-xs ${
                isSelected
                  ? 'border-kieks-aqua bg-kieks-aqua/15 text-kieks-navy dark:text-kieks-aqua'
                  : 'border-slate-300 bg-white text-slate-700 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200'
              }">
                <input data-question-id="${escapeHtml(question.id)}" data-option="${escapeHtml(option)}" data-input-kind="multi" type="checkbox" ${
                  isSelected ? 'checked' : ''
                } />
                <span>${escapeHtml(option)}</span>
              </label>`;
            }
            return `<button type="button" data-question-id="${escapeHtml(question.id)}" data-option="${escapeHtml(option)}" data-input-kind="single" class="rounded-xs border px-2 py-1 text-xs transition ${
              isSelected
                ? 'border-kieks-aqua bg-kieks-aqua/15 text-kieks-navy dark:text-kieks-aqua'
                : 'border-slate-300 bg-white text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700'
            }">${escapeHtml(option)}</button>`;
          })
          .join('');

        return `<fieldset class="rounded-xs border border-slate-300 bg-white p-2 dark:border-slate-600 dark:bg-slate-800">
          <legend class="px-1 text-xs font-semibold text-slate-700 dark:text-slate-300">${questionIndex + 1}. ${escapeHtml(question.label)}${question.multiSelect ? ' (multiple)' : ''}</legend>
          <div class="mt-2 flex flex-wrap gap-2">${optionsHtml}</div>
        </fieldset>`;
      })
      .join('');
    sendClarificationsButton.disabled = !hasAllQuestionAnswers();
  }

  function clearQuestions() {
    pendingQuestions = [];
    selectedClarifications.clear();
    renderClarificationQuestions();
  }

  function setBusy(isBusy: boolean) {
    if (!sendButton || !input || !finalizeButton || !sendClarificationsButton || !voiceButton) return;
    sendButton.disabled = isBusy;
    input.disabled = isBusy;
    finalizeButton.disabled = isBusy || messages.length === 0;
    sendClarificationsButton.disabled = isBusy || !hasAllQuestionAnswers();
    voiceButton.disabled = isBusy || !SpeechRecognitionCtor;
  }

  async function requestJson<T>(path: string, payload: unknown): Promise<T> {
    const normalizedPath = path.replace(/^\/+/, '');
    const requestUrl = apiBaseUrl
      ? `${apiBaseUrl.replace(/\/$/, '')}/${normalizedPath}`
      : `/${normalizedPath}`;
    const response = await fetch(requestUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await response.json();
    if (!response.ok) {
      throw new Error(data?.error ?? `Request failed with status ${response.status}`);
    }
    return data as T;
  }

  async function sendUserMessage(userText: string) {
    if (!status) return;
    if (!userText) return;

    messages.push({ role: 'user', content: userText });
    clearQuestions();
    renderMessages();
    setBusy(true);
    status.textContent = 'Generating assistant response...';
    try {
      const payload = { messages };
      const data = await requestJson<ChatResponsePayload>('api/skill-creator/chat', payload);
      messages.push({ role: 'assistant', content: String(data.message ?? 'I need a bit more detail to create a concrete skill package.') });
      pendingQuestions = Array.isArray(data.questions) ? data.questions : [];
      selectedClarifications.clear();
      renderMessages();
      renderClarificationQuestions();
      status.textContent = 'Reply ready. Continue chatting or create ZIP.';
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Unknown error during chat request.';
    } finally {
      setBusy(false);
    }
  }

  async function sendMessage() {
    if (!input) return;
    const userText = input.value.trim();
    if (!userText) return;
    input.value = '';
    await sendUserMessage(userText);
  }

  async function finalizePackage() {
    if (!status || !packagePreview || !downloadLink) return;
    if (messages.length === 0) return;
    setBusy(true);
    status.textContent = 'Creating package files...';
    try {
      const data = await requestJson<FinalizePayload>('api/skill-creator/finalize', { messages });
      const folder = String(data.skillFolderName ?? 'generated-skill');
      const files = data.files ?? {};
      const filePreview = Object.entries(files)
        .map(([relativePath, content]) => {
          const snippet = String(content).trim().slice(0, 400);
          return `# ${relativePath}\n${snippet}${String(content).length > 400 ? '\n... (truncated)' : ''}`;
        })
        .join('\n\n');
      packagePreview.textContent = filePreview || JSON.stringify(data, null, 2);

      const zip = new JSZip();
      for (const [relativePath, content] of Object.entries(files)) {
        zip.file(`${folder}/${relativePath}`, String(content));
      }
      const blob = await zip.generateAsync({ type: 'blob' });
      const url = URL.createObjectURL(blob);
      downloadLink.href = url;
      downloadLink.download = `${folder}.zip`;
      downloadLink.classList.remove('hidden');
      downloadLink.classList.add('inline-flex');
      status.textContent = 'ZIP is ready.';
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Unknown error while creating ZIP.';
    } finally {
      setBusy(false);
    }
  }

  renderMessages();
  renderClarificationQuestions();
  setBusy(false);
  if (!SpeechRecognitionCtor && voiceButton) {
    voiceButton.disabled = true;
    voiceButton.textContent = '🎤 Voice not supported';
  } else if (SpeechRecognitionCtor) {
    speechRecognition = new SpeechRecognitionCtor();
    speechRecognition.lang = 'en-US';
    speechRecognition.continuous = false;
    speechRecognition.interimResults = true;

    speechRecognition.onstart = () => {
      isVoiceListening = true;
      if (voiceButton) voiceButton.textContent = '⏹ Stop recording';
      if (status) status.textContent = 'Listening... speak now.';
    };

    speechRecognition.onresult = (event: any) => {
      if (!input) return;
      let transcript = '';
      for (let index = event.resultIndex; index < event.results.length; index += 1) {
        transcript += event.results[index][0]?.transcript ?? '';
      }
      if (!transcript.trim()) return;
      const prefix = input.value.trim().length > 0 ? `${input.value.trim()} ` : '';
      input.value = `${prefix}${transcript.trim()}`.trim();
    };

    speechRecognition.onerror = () => {
      if (status) status.textContent = 'Voice input failed. Please try again or type manually.';
    };

    speechRecognition.onend = () => {
      isVoiceListening = false;
      if (voiceButton) voiceButton.textContent = '🎤 Voice input';
      if (status && status.textContent === 'Listening... speak now.') {
        status.textContent = 'Voice input finished.';
      }
    };
  }

  sendButton?.addEventListener('click', () => {
    void sendMessage();
  });
  voiceButton?.addEventListener('click', () => {
    if (!speechRecognition) return;
    if (isVoiceListening) {
      speechRecognition.stop();
      return;
    }
    speechRecognition.start();
  });
  input?.addEventListener('keydown', (event) => {
    if (!(event instanceof KeyboardEvent)) return;
    if (event.key === 'Enter' && event.shiftKey) {
      event.preventDefault();
      void sendMessage();
    }
  });
  finalizeButton?.addEventListener('click', () => {
    void finalizePackage();
  });
  clarificationList?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const button = target.closest('button[data-input-kind="single"]');
    if (!(button instanceof HTMLButtonElement)) return;

    const questionId = button.dataset.questionId;
    const option = button.dataset.option;
    if (!questionId || !option) return;

    selectedClarifications.set(questionId, new Set([option]));
    renderClarificationQuestions();
  });
  clarificationList?.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement)) return;
    if (target.dataset.inputKind !== 'multi') return;
    const questionId = target.dataset.questionId;
    const option = target.dataset.option;
    if (!questionId || !option) return;

    const current = selectedClarifications.get(questionId) ?? new Set<string>();
    if (target.checked) {
      current.add(option);
    } else {
      current.delete(option);
    }
    selectedClarifications.set(questionId, current);
    renderClarificationQuestions();
  });
  sendClarificationsButton?.addEventListener('click', () => {
    if (!hasAllQuestionAnswers()) return;
    const clarificationText = pendingQuestions
      .map((question) => {
        const answer = Array.from(selectedClarifications.get(question.id) ?? []);
        return `- ${question.label}: ${answer.join(', ')}`;
      })
      .join('\n');
    void sendUserMessage(`Clarifications:\n${clarificationText}`);
  });
</script>

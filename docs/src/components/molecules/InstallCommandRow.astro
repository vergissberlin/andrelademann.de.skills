---
import IconButton from '../atoms/IconButton.astro';

interface Props {
  command: string;
  commandId?: string;
  buttonId?: string;
  /** Use the softer light-mode treatment when the row sits on a light surface. */
  tone?: 'dark' | 'soft';
}

const {
  command,
  commandId = 'install-cmd',
  buttonId = 'copy-btn',
  tone = 'dark'
} = Astro.props;
---

<div class="install-row flex flex-col gap-2.5 sm:flex-row sm:items-center">
  <code class:list={[
    'install-cmd min-w-0 flex-1 overflow-x-auto whitespace-nowrap rounded-lg border px-3.5 py-2.5 font-mono text-sm leading-relaxed shadow-inner',
    tone === 'soft'
      ? 'border-slate-200 bg-white/75 text-slate-700 shadow-slate-200/60 dark:border-white/15 dark:bg-slate-950/70 dark:text-slate-100 dark:shadow-black/30'
      : 'border-white/15 bg-slate-950/70 text-slate-100 shadow-black/30'
  ]} id={commandId}>{command}</code>
  <IconButton id={buttonId} class:list={[
    'btn-copy inline-flex shrink-0 items-center justify-center gap-1.5 rounded-lg border px-4 py-2.5 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-kieks-aqua/70 focus-visible:ring-offset-2',
    tone === 'soft'
      ? 'border-kieks-aqua-300 bg-kieks-aqua-100 text-kieks-navy hover:border-kieks-aqua hover:bg-kieks-aqua-200 focus-visible:ring-offset-white dark:border-white/25 dark:bg-white/10 dark:text-white dark:hover:border-white/45 dark:hover:bg-white/20 dark:focus-visible:ring-offset-slate-900'
      : 'border-white/25 bg-white/10 text-white hover:border-white/45 hover:bg-white/20 focus-visible:ring-offset-slate-900'
  ]} ariaLabel="Copy install command">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <rect x="9" y="9" width="13" height="13" rx="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </svg>
    <span>Copy</span>
  </IconButton>
</div>

---
import InstallCommandRow from './InstallCommandRow.astro';

const addCommand = '/plugin marketplace add vergissberlin/andrelademann.de.skills';
const installCommand = '/plugin install andrelademann-skills@vergissberlin';
---

<details class="group mb-8 overflow-hidden rounded-xl border border-kieks-aqua-200 bg-kieks-aqua-50/60 shadow-sm dark:border-slate-700 dark:bg-slate-900">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 marker:hidden md:p-6">
    <div class="min-w-0">
      <span class="inline-flex rounded-full bg-kieks-navy px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.14em] text-white dark:bg-kieks-aqua dark:text-kieks-navy">
        Claude Code
      </span>
      <h2 id="marketplace-title" class="mt-3 font-heading text-xl font-bold text-kieks-navy dark:text-white">
        Add the complete marketplace
      </h2>
    </div>
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-kieks-aqua-300 bg-white/70 text-kieks-navy transition group-open:rotate-180 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
    </span>
  </summary>

  <div class="grid gap-5 border-t border-kieks-aqua-200 px-5 pb-5 pt-4 md:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] md:px-6 md:pb-6 dark:border-slate-700">
    <p class="text-sm leading-6 text-slate-600 dark:text-slate-300">
      Run these commands in Claude Code to register the repository and install the complete skill catalog.
    </p>

    <div class="space-y-3 rounded-lg bg-white/45 p-4 dark:bg-slate-950">
      <InstallCommandRow command={addCommand} commandId="marketplace-add-cmd" buttonId="marketplace-add-copy" tone="soft" />
      <InstallCommandRow command={installCommand} commandId="marketplace-install-cmd" buttonId="marketplace-install-copy" tone="soft" />
    </div>
  </div>
</details>

<script>
  document.querySelectorAll<HTMLButtonElement>('#marketplace-add-copy, #marketplace-install-copy').forEach((button) => {
    button.addEventListener('click', async () => {
      const command = button.previousElementSibling?.textContent?.trim();
      if (!command) return;
      await navigator.clipboard.writeText(command);
      const label = button.querySelector('span');
      if (label) label.textContent = 'Copied!';
      window.setTimeout(() => {
        if (label) label.textContent = 'Copy';
      }, 2000);
    });
  });
</script>

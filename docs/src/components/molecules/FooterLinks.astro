---
import { getCatalogVersion } from '../../lib/catalogVersion';

interface LinkItem {
  href: string;
  label: string;
}

interface Props {
  prefix?: string;
  links: LinkItem[];
  /** When unset, `index.json` `version` is shown (release tag in published builds). */
  catalogVersion?: string | null;
  showCatalogVersion?: boolean;
  footerClass?: string;
  containerClass?: string;
}

const {
  prefix,
  links,
  catalogVersion: catalogVersionProp,
  showCatalogVersion = true,
  footerClass = 'border-t border-slate-200 px-4 pb-8 pt-4 text-sm text-slate-500 dark:border-slate-800 dark:text-slate-400',
  containerClass = 'mx-auto max-w-6xl'
} = Astro.props;

const catalogVersion: string | null = !showCatalogVersion
  ? null
  : catalogVersionProp !== undefined
    ? catalogVersionProp
    : getCatalogVersion();

const baseUrl = import.meta.env.BASE_URL;
const portrait = `${baseUrl}brand/andre-lademann.webp`;
---

<footer class={footerClass}>
  <div class:list={[containerClass, 'flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between']}>
    <a
      href={baseUrl}
      class="group inline-flex w-fit items-center gap-3 rounded-full pr-3 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-kieks-aqua"
      aria-label="André Lademann Agents — home"
    >
      <img src={portrait} alt="André Lademann" width="1024" height="1024" class="h-9 w-9 rounded-full border-2 border-kieks-aqua object-cover shadow-sm transition group-hover:border-kieks-fuchsia" loading="lazy" decoding="async" />
      <span class="font-heading text-sm font-semibold text-kieks-navy dark:text-slate-200">André Lademann Agents</span>
    </a>

    <div class="text-left sm:text-right">
      <div>
        {prefix && <>{prefix} · </>}
        {links.map((link, idx) => (
          <>
            {idx > 0 && <> · </>}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
        {catalogVersion && (
          <>
            {' '}
            ·{' '}
            <span
              class="font-mono tabular-nums text-slate-400 dark:text-slate-500"
              title="Catalog version (matches the published release git tag)"
            >
              {catalogVersion}
            </span>
          </>
        )}
      </div>
      <p class="mt-2 text-xs text-slate-400 dark:text-slate-500">Agent Skills by André Lademann</p>
    </div>
  </div>
</footer>
